{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "placement_registry.json",
  "title": "Реестр размещений",
  "description": "Базовая схема плюс таблица размещений и параметры рекламных кампаний.",
  "allOf": [{ "$ref": "default_scheme.json" }],
  "required": ["placements", "campaigns"],
  "properties": {
    "document_type": { "const": "placement_registry" },

    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "channel", "performer", "campaign_code", "campaign_name", "placements_count", "amount"],
        "properties": {
          "code": { "type": ["string", "null"] },
          "channel": { "type": ["string", "null"], "description": "Канал или псевдоним." },
          "performer": { "type": ["string", "null"], "description": "Исполнитель или правообладатель." },
          "campaign_code": { "type": ["string", "null"] },
          "campaign_name": { "type": ["string", "null"] },
          "placements_count": { "type": ["integer", "null"] },
          "amount": { "$ref": "default_scheme.json#/$defs/money" }
        }
      }
    },

    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["campaign_code", "client", "material_type", "report_id"],
        "properties": {
          "campaign_code": { "type": ["string", "null"] },
          "client": { "type": ["string", "null"], "description": "Заказчик исходной рекламной кампании." },
          "material_type": { "type": ["string", "null"] },
          "report_id": { "type": ["string", "null"] }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
