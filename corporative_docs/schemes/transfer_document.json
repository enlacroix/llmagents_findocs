{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transfer_document.json",
  "title": "Универсальный передаточный документ",
  "description": "Базовая схема плюс статус УПД и сведения о передаче груза.",
  "allOf": [{ "$ref": "default_scheme.json" }],
  "required": ["upd_status", "shipment"],
  "properties": {
    "document_type": { "const": "transfer_document" },

    "upd_status": {
      "type": ["integer", "null"],
      "description": "Статус УПД: 1 — счет-фактура и передаточный документ, 2 — только передаточный документ."
    },

    "shipment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shipment_date", "delivery_place", "packages", "gross_weight_kg"],
          "properties": {
            "shipment_date": { "$ref": "default_scheme.json#/$defs/date" },
            "delivery_place": { "type": ["string", "null"] },
            "packages": { "type": ["integer", "null"] },
            "gross_weight_kg": { "type": ["number", "null"] }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "unevaluatedProperties": false
}
