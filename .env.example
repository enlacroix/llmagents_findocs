# DeepSeek API: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model for OCR (must accept images) and for extraction
DEEPSEEK_MODEL=deepseek-flash

# PostgreSQL (docker compose publishes it on localhost)
POSTGRES_PASSWORD=findocs
DATABASE_URL=postgresql://findocs:findocs@localhost:5432/findocs
